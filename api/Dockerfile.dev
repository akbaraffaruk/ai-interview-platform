# Local development image for the API.
# Unlike ./Dockerfile (production), this keeps the development + test bundles (rspec, rubocop, factory_bot),
# so `docker compose -f docker-compose.dev.yml exec api bundle exec rspec` works.
FROM ruby:3.3.2

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    libpq-dev \
    postgresql-client \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs 4

CMD ["bash"]
